; Conecta la librería compilada en Rust (.so) con el motor Godot 4.7.
; Mapea las arquitecturas de 64 bits (arm64-v8a) y 32 bits (armeabi-v7a) para Android.

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
android.debug.arm64 = "res://bin/arm64-v8a/libshooter_core.so"
android.debug.armeabi-v7a = "res://bin/armeabi-v7a/libshooter_core.so"
android.release.arm64 = "res://bin/arm64-v8a/libshooter_core.so"
android.release.armeabi-v7a = "res://bin/armeabi-v7a/libshooter_core.so"
; Si algún día abres el proyecto en un PC Linux para depurar, descomenta la siguiente línea:
; linux.debug.x86_64 = "res://../rust/target/debug/libshooter_core.so"
