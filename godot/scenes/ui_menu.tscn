[node name="BriefText" type="Label" parent="MainMargin/RootHBox/LeftColumn/BriefingPanel/BriefVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.87, 0.92, 1)
theme_override_font_sizes/font_size = 14
text = "• Escenario: Ciudad destruida con barreras Jersey, trincheras de sacos, vehículos calcinados y edificios con rampa.\n• Arma principal: Rifle clásico 7.62 (30/120), fogonazo, trazadoras y casquillos expulsados.\n• IA local inteligente: evalúa línea de tiro real, se agacha tras barreras al recargar, dispara en ráfagas y flanquea si te escondes."
autowrap_mode = 2

