[node name="Body" type="Label" parent="ControlsPopup/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "• Joystick izquierdo: mover la cápsula. Empujar al borde superior activa carrera (sprint).\n• Mitad derecha de pantalla: desliza el dedo para girar la cámara y apuntar con precisión.\n• Botón AGACHAR: reduce tu silueta detrás de barreras Jersey y sacos de arena y mejora la precisión del AK-7.62.\n• Botón DISPARAR / RECARGAR / SALTAR / CAM: acciones táctiles directas.\n• Respaldo PC: WASD + Ratón, C (Agachar), R (Recargar), Espacio (Saltar)."
autowrap_mode = 2

[node name="BtnCloseControls" type="Button" parent="ControlsPopup/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "ENTENDIDO"
